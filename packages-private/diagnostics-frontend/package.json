{
	"name": "diagnostics-frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"eslint": "bunx --bun eslint './**/*.{js,jsx,ts,tsx}'",
		"inspect-browser": "bun src/inspect-browser.ts",
		"lint": "bun run typecheck && bun run eslint",
		"render-browser-html": "bun src/render-browser-html.ts",
		"render-md": "bun src/render-md.ts",
		"test": "bun run --bun vitest run",
		"typecheck": "bun run --bun tsc --noEmit"
	},
	"dependencies": {
		"diagnostics-shared": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"frontend": "workspace:*",
		"playwright": "1.62.1",
		"vitest": "4.1.11"
	}
}
