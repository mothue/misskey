{
	"name": "changelog-checker",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "bun src/index.ts",
		"eslint": "bunx --bun eslint './**/*.{js,jsx,ts,tsx}'",
		"lint": "bun run typecheck && bun run eslint",
		"test": "bun run --bun vitest run",
		"test:coverage": "bun run --bun vitest run --coverage",
		"typecheck": "bun run --bun tsc --noEmit"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"@types/node": "26.4.0",
		"@vitest/coverage-v8": "4.1.11",
		"mdast-util-to-string": "4.0.0",
		"remark": "15.0.1",
		"remark-parse": "11.0.0",
		"unified": "11.0.5",
		"vitest": "4.1.11"
	}
}
