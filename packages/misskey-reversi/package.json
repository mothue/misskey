{
	"type": "module",
	"name": "misskey-reversi",
	"version": "0.0.1",
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"import": "./built/index.js",
			"types": "./built/index.d.ts",
			"default": "./built/index.js"
		},
		"./*": {
			"import": "./built/*",
			"types": "./built/*",
			"default": "./built/*"
		}
	},
	"scripts": {
		"build": "bun ./build.js",
		"watch": "bun ./build.js --watch",
		"eslint": "bunx --bun eslint './**/*.{js,jsx,ts,tsx}'",
		"typecheck": "bun run --bun tsc --noEmit",
		"lint": "bun run typecheck && bun run eslint"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"esbuild": "0.28.2",
		"execa": "10.0.1"
	},
	"files": [
		"built"
	],
	"dependencies": {
		"crc-32": "1.2.2"
	}
}
