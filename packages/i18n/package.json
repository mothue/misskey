{
	"name": "i18n",
	"type": "module",
	"private": true,
	"main": "./built/index.js",
	"types": "./built/index.d.ts",
	"exports": {
		".": {
			"types": "./built/index.d.ts",
			"import": "./built/index.js"
		},
		"./const": {
			"types": "./built/const.d.ts",
			"import": "./built/const.js"
		}
	},
	"scripts": {
		"generate": "bun scripts/generateLocaleInterface.ts",
		"verify": "bun scripts/verify.ts",
		"build": "bun ./build.ts",
		"watch": "bun ./build.ts --watch",
		"tsd": "bun run --bun tsd",
		"typecheck": "bun run --bun tsc --noEmit",
		"lint": "bun run typecheck && bunx --bun eslint",
		"lint:fix": "bunx --bun eslint --fix"
	},
	"files": [
		"built"
	],
	"devDependencies": {
		"@types/node": "26.4.0",
		"@typescript-eslint/eslint-plugin": "8.68.0",
		"@typescript-eslint/parser": "8.68.0",
		"chokidar": "5.0.0",
		"esbuild": "0.28.2",
		"execa": "10.0.1"
	},
	"dependencies": {
		"js-yaml": "5.4.1"
	}
}
